<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- The version of the app. The release workflow overrides it with the
         tag it builds (-p:Version=...), so the package and the binary
         cannot disagree. The other version numbers follow it. -->
    <Version>0.2.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>oloop</Product>
    <AssemblyTitle>oloop</AssemblyTitle>
    <Company>oloop</Company>
    <!-- The executable is called oloop, not OloopApp — the name shows up in
         the task bar, in the app bundle and in the file manager. -->
    <AssemblyName>oloop</AssemblyName>
    <!-- The app has no network access, so the default is fine. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No debug symbols in a release: they double the size of the
         package and nobody needs them without a matching build. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- The icon of the executable is platform specific: a .ico for Windows,
       a .icns for macOS. Both live in Assets. The condition looks at the
       target runtime, not at the host, so a cross publish carries the
       icon too. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationIcon>Assets\oloop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The test project lives inside this folder; it has its own compilation. -->
  <ItemGroup>
    <Compile Remove="OloopApp.Tests\**" />
    <None Remove="OloopApp.Tests\**" />
    <AvaloniaResource Remove="OloopApp.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- YAML frontmatter: low-level Parser API keeps timestamps as strings. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Markdown rendering for the task description (incl. code blocks). -->
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>
</Project>
