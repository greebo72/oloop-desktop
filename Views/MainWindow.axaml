<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OloopApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="oloop"
        Background="{StaticResource OloopBgBrush}"
        FontFamily="Inter">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- App-Layout: Top-Bar | Sidebar | Content -->
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*">

        <!-- ============ Top-Bar ============ -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{StaticResource SurfaceBrush}"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Marken-Block -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="10" Padding="10,6">
                        <TextBlock Text="⟳" FontSize="18"
                                   Foreground="{StaticResource OnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="oloop"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Cross-Projekt-Tracker"
                               FontSize="12" Classes="TextMuted"
                               VerticalAlignment="Center" Margin="4,4,0,0" />
                </StackPanel>

                <!-- Suche + Filter-Chips -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="24,0">
                    <TextBox Classes="SearchBox" Width="320" />
                    <Button Content="Open">
                        <Button.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="FontFamily" Value="Inter" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="Meine Tasks" Classes="ButtonTonal" />
                    <Button Content="Stale" Classes="ButtonTonal" />
                </StackPanel>

                <!-- Quick-Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="＋ Task" Classes="ButtonPrimary" />
                    <Button Content="＋ Projekt" Classes="ButtonTonal" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Sidebar: Projekte ============ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                Padding="12" MinWidth="220">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="PROJEKTE"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="8,4,8,10" />

                <!-- Sidebar-Navigation (placeholder bis auf Projekt-DataTemplate) -->
                <StackPanel Spacing="4">
                    <Border Classes="Card" Padding="10" Margin="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="OloopApp"
                                       FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="5 open · 2 stale"
                                       Classes="TextMuted" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card" Padding="10" Margin="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server-Haus"
                                       FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="3 open of 7"
                                       Classes="TextMuted" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card" Padding="10" Margin="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Side Projects"
                                       FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="1 open of 2"
                                       Classes="TextMuted" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content: Projekt-Übersicht ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <StackPanel Margin="20" Spacing="16">

                <!-- Abschnitts-Header -->
                <Grid>
                    <TextBlock Text="Alle Projekte" Classes="TitleH1"
                               VerticalAlignment="Center" />
                    <TextBlock Text="12 tasks · 3 Projekte"
                               Classes="TextMuted" FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Projekt-Karten (Grid, responsive) -->
                <ItemsControl x:Name="ProjectCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Beispiel-Karte; wird in Schritt 2 per DataTemplate ersetzt -->
                    <Border Classes="Card" Width="330" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="OloopApp"
                                           FontSize="16" FontWeight="SemiBold" />
                                <Border Classes="Chip Chip-Feature"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="active" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="Chip Chip-Todo">
                                    <TextBlock Text="4 todo" />
                                </Border>
                                <Border Classes="Chip Chip-Decision">
                                    <TextBlock Text="2 decision" />
                                </Border>
                                <Border Classes="Chip Chip-Bug">
                                    <TextBlock Text="1 bug" />
                                </Border>
                            </StackPanel>
                            <ProgressBar
                                    Value="4" Maximum="7"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Background="{StaticResource SurfaceHighestBrush}"
                                    Height="4" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="4 open of 7"
                                           Classes="TextMuted" FontSize="12" />
                                <TextBlock Text="2 stale"
                                           Classes="TextMuted" FontSize="12"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card" Width="330" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Server-Haus"
                                           FontSize="16" FontWeight="SemiBold" />
                                <Border Classes="Chip Chip-Question"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="waiting" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="Chip Chip-Question">
                                    <TextBlock Text="3 question" />
                                </Border>
                                <Border Classes="Chip Chip-Closed">
                                    <TextBlock Text="4 closed" />
                                </Border>
                            </StackPanel>
                            <ProgressBar
                                    Value="3" Maximum="7"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Background="{StaticResource SurfaceHighestBrush}"
                                    Height="4" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="3 open of 7"
                                           Classes="TextMuted" FontSize="12" />
                                <TextBlock Text="1 stale"
                                           Classes="TextMuted" FontSize="12"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>