<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        xmlns:controls="using:OloopApp.Controls"
        x:Class="OloopApp.Views.NewTaskDialog"
        x:DataType="vm:NewTaskViewModel"
        Title="New task"
        Width="560" SizeToContent="Height"
        MinWidth="480"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <Window.Styles>
        <!-- The five type buttons of the type row: a filled type container with
             the icon of the type on it. -->
        <Style Selector="Button.TypeOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.TypeOption:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
        </Style>
    </Window.Styles>

    <!-- The dialog background is opaque on purpose: a transparent popup would
         let the window behind it bleed through. -->
    <Border Background="{StaticResource SurfaceBrush}" Padding="20,16,20,16">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <!-- ============================================================
                 Header
                 ============================================================ -->
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="New task" Classes="TitleLarge" />
                <TextBlock Text="{Binding Project.Name}" Classes="BodyMedium" />
            </StackPanel>

            <!-- ============================================================
                 Type row: five buttons, one per type
                 ============================================================ -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="Type" Classes="SectionHeader" />
                <ItemsControl ItemsSource="{Binding TypeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskTypeOption">
                            <Button Classes="TypeOption" Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="6">
                                    <Border Classes="IconContainer"
                                            Background="{Binding BackgroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}"
                                            BorderBrush="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}"
                                            BorderThickness="{Binding SelectionThickness}"
                                            Opacity="{Binding ContainerOpacity}">
                                        <PathIcon Data="{Binding IconKey, Converter={x:Static controls:ResourceGeometryConverter.Instance}}"
                                                  Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Classes="LabelSmall"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================================================
                 Title
                 ============================================================ -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="Title" Classes="SectionHeader" />
                <TextBox Text="{Binding Title, Mode=TwoWay}"
                         PlaceholderText="What has to be done?"
                         MaxLength="300" />
                <TextBlock Text="{Binding TitleError}" Classes="Muted"
                           IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- ============================================================
                 Description (Markdown)
                 ============================================================ -->
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="Description" Classes="SectionHeader" />
                <TextBox Text="{Binding Description, Mode=TwoWay}"
                         PlaceholderText="Markdown is supported."
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinLines="3" MaxLines="10"
                         VerticalContentAlignment="Top" />
            </StackPanel>

            <!-- ============================================================
                 Labels
                 ============================================================ -->
            <StackPanel Grid.Row="4" Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="Labels" Classes="SectionHeader" />
                <TextBox Text="{Binding LabelsText, Mode=TwoWay}"
                         PlaceholderText="comma separated, e.g. ui, backend" />
            </StackPanel>

            <!-- ============================================================
                 Due date
                 ============================================================ -->
            <StackPanel Grid.Row="5" Spacing="6" Margin="0,0,0,18">
                <TextBlock Text="Due date" Classes="SectionHeader" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                        Watermark="No due date"
                                        MinWidth="200" />
                    <Button Classes="Text" Content="Clear"
                            Command="{Binding ClearDueDateCommand}"
                            IsEnabled="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Remove the due date" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================================
                 Actions — exactly one filled primary button on the screen
                 ============================================================ -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button Classes="Text" Content="Cancel" Click="OnCancelClick" />
                <Button Classes="Primary" Content="Create" Click="OnCreateClick"
                        IsEnabled="{Binding CanSave}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
