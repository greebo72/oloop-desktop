<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        x:Class="OloopApp.Views.ConflictDialog"
        x:DataType="vm:ConflictViewModel"
        Title="Write conflict"
        Width="520" SizeToContent="Height"
        MinWidth="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <!-- The dialog background is opaque on purpose: a transparent popup would
         let the window behind it bleed through. -->
    <Border Background="{StaticResource SurfaceBrush}" Padding="20,16,20,16">
        <StackPanel Spacing="14">

            <!-- ============================================================
                 Header
                 ============================================================ -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="IconContainer"
                        Background="{StaticResource TertiaryContainerBrush}">
                    <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20"
                              Foreground="{StaticResource OnTertiaryContainerBrush}" />
                </Border>
                <TextBlock Text="Write conflict" Classes="TitleLarge" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ============================================================
                 Explanation
                 ============================================================ -->
            <TextBlock Text="{Binding Message}" Classes="BodyLarge" TextWrapping="Wrap" />

            <!-- The task that was not written. -->
            <Border Classes="Card" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Task" Classes="LabelMedium" />
                    <TextBlock Text="{Binding TaskTitle}" Classes="TitleMedium" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============================================================
                 Actions. Nothing is overwritten silently — the user has to
                 pick "Overwrite" explicitly. Exactly one filled primary
                 button on the screen.
                 ============================================================ -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Text" Content="Cancel" Click="OnCancelClick" />
                <Button Classes="Outlined" Content="Reload" Click="OnReloadClick" />
                <Button Classes="Primary" Content="Overwrite" Click="OnOverwriteClick" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
