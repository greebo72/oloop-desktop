<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OloopApp.ViewModels"
             xmlns:controls="using:OloopApp.Controls"
             x:Class="OloopApp.Views.TaskDetailView"
             x:DataType="vm:TaskDetailViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,8,24,24" Spacing="16">

            <!-- Type chip, status and the actions -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                    <Border Classes="Chip"
                            Background="{Binding BackgroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{Binding IconKey, Converter={x:Static controls:ResourceGeometryConverter.Instance}}"
                                      Width="14" Height="14"
                                      Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding TypeName}"
                                       Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusOpenBrush}"
                                 IsVisible="{Binding !IsClosed}" />
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource OutlineBrush}"
                                 IsVisible="{Binding IsClosed}" />
                        <TextBlock Text="{Binding StatusLabel}" Classes="LabelMedium" />
                    </StackPanel>

                </StackPanel>

                <!-- The actions of the task. Exactly one filled primary
                     button on the screen: Save while editing. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">

                    <!-- Viewing -->
                    <Button Classes="Icon" Command="{Binding EditCommand}"
                            IsVisible="{Binding !IsEditing}"
                            ToolTip.Tip="Edit the task (Ctrl+E)">
                        <PathIcon Data="{StaticResource IconEdit}" />
                    </Button>

                    <Button Classes="Outlined"
                            Command="{Binding CloseCommand}"
                            IsVisible="{Binding ShowClose}"
                            ToolTip.Tip="Close the task">
                        <TextBlock Text="Close" />
                    </Button>

                    <Button Classes="Outlined"
                            Command="{Binding ReopenCommand}"
                            IsVisible="{Binding ShowReopen}"
                            ToolTip.Tip="Reopen the task">
                        <TextBlock Text="Reopen" />
                    </Button>

                    <!-- Editing -->
                    <Button Classes="Text" Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsEditing}"
                            ToolTip.Tip="Drop the changes" />
                    <Button Classes="Primary" Content="Save"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            IsVisible="{Binding IsEditing}"
                            ToolTip.Tip="Save the changes" />

                </StackPanel>

            </Grid>

            <!-- Viewing: title, labels, description -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsEditing}">

                <TextBlock Text="{Binding Title}" Classes="HeadlineSmall" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Classes="Chip Outlined" Margin="0,0,8,0">
                                <TextBlock Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding DescriptionView}" IsVisible="{Binding HasDescription}" />

            </StackPanel>

            <!-- Editing: the same fields as input. The type is immutable, so
                 it stays the chip above. -->
            <StackPanel Spacing="14" IsVisible="{Binding IsEditing}">

                <StackPanel Spacing="6">
                    <TextBlock Text="Title" Classes="SectionHeader" />
                    <TextBox Name="TitleBox"
                             Text="{Binding Editor.Title, Mode=TwoWay}"
                             PlaceholderText="What has to be done?"
                             MaxLength="300" />
                    <TextBlock Text="{Binding Editor.TitleError}" Classes="Muted"
                               IsVisible="{Binding Editor.TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Description" Classes="SectionHeader" />
                    <TextBox Text="{Binding Editor.Description, Mode=TwoWay}"
                             PlaceholderText="Markdown is supported."
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinLines="3" MaxLines="14"
                             VerticalContentAlignment="Top" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Labels" Classes="SectionHeader" />
                    <TextBox Text="{Binding Editor.LabelsText, Mode=TwoWay}"
                             PlaceholderText="comma separated, e.g. ui, backend" />
                </StackPanel>

            </StackPanel>

            <!-- The image of the task, when it has one. -->
            <Border Classes="Card" Padding="0"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasImage}">
                <Image Source="{Binding Image}"
                       Stretch="Uniform"
                       MaxHeight="320" />
            </Border>

            <!-- The image is missing or cannot be read — the task says so
                 instead of showing a broken picture. -->
            <Border Classes="Card" Padding="12" IsVisible="{Binding HasImageError}">
                <StackPanel Spacing="4">
                    <TextBlock Text="The image could not be shown" Classes="TitleMedium" />
                    <TextBlock Text="{Binding ImageError}" Classes="BodyMedium" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Meta -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding CreatedText}" Classes="Muted" />
                <TextBlock Text="{Binding UpdatedText}" Classes="Muted" />
            </StackPanel>

            <!-- Comments -->
            <StackPanel Spacing="8">
                <TextBlock Text="Comments" Classes="SectionHeader" />

                <Border Classes="Card" Padding="12" Margin="0,0,0,6"
                        IsVisible="{Binding HasComments}">
                    <ItemsControl ItemsSource="{Binding Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommentViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CreatedText}" Classes="Muted" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Classes="Card" Padding="12" Margin="0,0,0,6"
                        IsVisible="{Binding !HasComments}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="No comments yet" Classes="BodyMedium" />
                        <TextBlock Classes="Muted" TextWrapping="Wrap"
                                   Text="Write the first comment to note a decision or a next step." />
                    </StackPanel>
                </Border>

                <!-- The comment field. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             IsEnabled="{Binding !IsEditing}"
                             Text="{Binding CommentText, Mode=TwoWay}"
                             PlaceholderText="Add a comment…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MaxLines="4" MinLines="1"
                             VerticalContentAlignment="Top" />
                    <Button Grid.Column="1" Classes="Primary" VerticalAlignment="Top"
                            Command="{Binding AddCommentCommand}"
                            IsEnabled="{Binding CanAddComment}"
                            ToolTip.Tip="Add the comment">
                        <PathIcon Data="{StaticResource IconSend}" />
                    </Button>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
