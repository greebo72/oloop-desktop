<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OloopApp.ViewModels"
             xmlns:models="using:OloopApp.Core.Models"
             xmlns:controls="using:OloopApp.Controls"
             x:Class="OloopApp.Views.TaskListView"
             x:DataType="vm:TaskListViewModel">

    <ScrollViewer>
        <StackPanel Margin="12,4,12,16" Spacing="8">

            <!-- Groups -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskGroupViewModel">
                        <StackPanel Spacing="2">

                            <Button Classes="GroupHeader"
                                    Command="{Binding ToggleCommand}"
                                    IsVisible="{Binding HasTitle}"
                                    ToolTip.Tip="{Binding ToggleToolTip}"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconDropDown}" Width="16" Height="16"
                                              IsVisible="{Binding IsExpanded}" />
                                    <PathIcon Data="{StaticResource IconChevronRight}" Width="16" Height="16"
                                              IsVisible="{Binding !IsExpanded}" />
                                    <TextBlock Text="{Binding HeaderText}" Classes="SectionHeader" />
                                </StackPanel>
                            </Button>

                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                                        <Border Classes="Card" Padding="0" Margin="0,0,0,4">
                                            <!-- The row is a button that opens the
                                                 detail, and next to it the edit
                                                 button — a button cannot be
                                                 nested in a button. -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Background="Transparent"
                                                        Padding="12"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[ItemsControl].((vm:TaskGroupViewModel)DataContext).SelectCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                                        <!-- Type icon on the type container -->
                                                        <Border Classes="IconContainer"
                                                                Background="{Binding BackgroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}">
                                                            <PathIcon Data="{Binding IconKey, Converter={x:Static controls:ResourceGeometryConverter.Instance}}"
                                                                      Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Classes="TitleMedium"
                                                                       Classes.Closed="{Binding IsClosed}"
                                                                       MaxLines="2"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                        Classes.ClosedMeta="{Binding IsClosed}">
                                                                <TextBlock Text="{Binding TypeName}" Classes="BodyMedium" />
                                                                <TextBlock Text="·" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                                                <TextBlock Text="{Binding LabelsText}" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                                                <TextBlock Text="·" Classes="BodyMedium" IsVisible="{Binding HasDueDate}" />
                                                                <Border Classes="Chip Chip-Overdue" IsVisible="{Binding IsOverdue}">
                                                                    <TextBlock Text="overdue" />
                                                                </Border>
                                                                <TextBlock Text="{Binding DueDateText}" Classes="BodyMedium"
                                                                           ToolTip.Tip="Due date"
                                                                           IsVisible="{Binding HasDueDate}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Age}"
                                                                   Classes="Muted"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Classes="Icon"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[ItemsControl].((vm:TaskGroupViewModel)DataContext).EditCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Edit the task (Ctrl+E)">
                                                    <PathIcon Data="{StaticResource IconEdit}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Name="EmptyStateCard" Classes="Card"
                    IsVisible="{Binding IsEmpty}" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding EmptyTitle}" Classes="TitleMedium" />
                    <TextBlock Classes="BodyMedium" TextWrapping="Wrap"
                               Text="{Binding EmptyText}" />
                </StackPanel>
            </Border>

            <!-- Files of this project that could not be read. They are
                 never written to. -->
            <StackPanel IsVisible="{Binding HasUnreadable}" Spacing="4" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource StatusOpenBrush}" />
                    <TextBlock Text="{Binding UnreadableSummary}" Classes="SectionHeader" />
                </StackPanel>

                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="These files are left untouched. Fix them in the data folder and reload to see them." />

                <ItemsControl ItemsSource="{Binding Unreadable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:UnreadableFile">
                            <Border Classes="Card" Margin="0,4,0,0" Padding="12"
                                    Background="{StaticResource SurfaceContainerHighBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Path}" Classes="LabelMedium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Reason}" Classes="Muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
