<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OloopApp.Views.ConfirmDialog"
        Title="Confirm"
        Width="460"
        SizeToContent="Height"
        MinWidth="400"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <Border Background="{StaticResource SurfaceContainerHighBrush}" Padding="24,20,24,20">
        <StackPanel Spacing="18">
            <TextBlock Name="TitleText" Classes="TitleLarge" TextWrapping="Wrap" />
            <TextBlock Name="MessageText" Classes="BodyMedium" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <!-- The safe answer is the primary one: cancelling. -->
                <Button Classes="Text" Name="ConfirmButton" Click="OnConfirmClick" />
                <Button Classes="Primary" Click="OnCancelClick" Content="Cancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
