<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OloopApp.ViewModels"
             xmlns:models="using:OloopApp.Core.Models"
             xmlns:controls="using:OloopApp.Controls"
             x:Class="OloopApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="16,8,16,16" Spacing="8">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,8">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Projects" Classes="TitleLarge" IsVisible="{Binding ShowProjects}" />
                    <TextBlock Text="Tasks" Classes="TitleLarge" IsVisible="{Binding SearchTasks}" />
                    <!-- The summary counts projects, so it belongs to the project
                         view. In the task view the title sits on the line of the
                         filters. -->
                    <TextBlock Text="{Binding Summary}" Classes="BodyMedium" IsVisible="{Binding ShowProjects}" />
                </StackPanel>

                <!-- The filters of the task search. In the project search they
                     have no effect, so they are hidden there. -->
                <WrapPanel Name="TaskFilterBar" Orientation="Horizontal"
                           ItemSpacing="12" LineSpacing="8"
                           Grid.Column="1" Margin="32,0,16,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding SearchTasks}">
                    <ComboBox Name="DueFilterBox"
                              ItemsSource="{Binding DueFilterOptions}"
                              SelectedItem="{Binding SelectedDueFilter, Mode=TwoWay}"
                              ToolTip.Tip="Filter by due date">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DueFilterOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The labels to pick from. The list comes from the loaded
                         tasks, several labels can be picked, a task matches when
                         it carries at least one of them. -->
                    <Button Name="LabelFilterButton" Classes="Dropdown"
                            Classes.Active="{Binding HasSelectedLabels}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Filter by label">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" MinWidth="240">
                                    <TextBlock Text="No labels in these tasks" Classes="Muted"
                                               IsVisible="{Binding HasNoLabels}" />
                                    <ScrollViewer MaxHeight="320" IsVisible="{Binding !HasNoLabels}">
                                        <ItemsControl ItemsSource="{Binding LabelOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LabelOptionViewModel">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                                   Classes="Muted" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button Classes="Text" Content="Clear labels" HorizontalAlignment="Left"
                                            Command="{Binding ClearLabelsCommand}"
                                            IsVisible="{Binding HasSelectedLabels}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding LabelFilterText}" VerticalAlignment="Center" />
                            <PathIcon Data="{StaticResource IconDropDown}" Width="16" Height="16"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ComboBox Name="TaskSortBox"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              ToolTip.Tip="Sort the results">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskSortOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Name="ShowClosedBox"
                              Content="Show closed"
                              IsChecked="{Binding ShowClosed, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </WrapPanel>

                <!-- Without a data folder there is nothing to create a
                     project in yet — the settings come first. -->
                <Button Grid.Column="2"
                        Classes="Outlined"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ShowNewProjectButton}"
                        Click="OnNewProjectClick"
                        ToolTip.Tip="Create a project in the data folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                        <TextBlock Text="New project" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- The labels of the filter, each can be removed on its own. -->
            <ItemsControl Name="SelectedLabelChips" ItemsSource="{Binding SelectedLabels}"
                          IsVisible="{Binding SearchTasks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabelOptionViewModel">
                        <Border Classes="Chip Outlined" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" />
                                <Button Classes="Icon" Padding="0" MinHeight="0" MinWidth="0"
                                        Width="16" Height="16"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).RemoveLabelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Remove the label from the filter">
                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state: no data folder, or no project in it. -->
            <Border Name="EmptyStateCard" Classes="Card"
                    IsVisible="{Binding ShowEmptyState}" Padding="24">
                <StackPanel Spacing="8">
                    <PathIcon Data="{StaticResource IconFolder}" Width="32" Height="32"
                              HorizontalAlignment="Left"
                              Foreground="{StaticResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="{Binding EmptyTitle}" Classes="TitleMedium" />
                    <TextBlock Classes="BodyMedium" TextWrapping="Wrap"
                               Text="{Binding EmptyText}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <!-- Without a data folder there is nothing to create
                             a project in yet — the settings come first. -->
                        <Button Classes="Outlined"
                                IsVisible="{Binding HasNoDataRoot}"
                                Click="OnSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
                                <TextBlock Text="Open settings" />
                            </StackPanel>
                        </Button>

                        <Button Classes="Outlined"
                                IsVisible="{Binding !HasNoDataRoot}"
                                Click="OnNewProjectClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                <TextBlock Text="New project" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Task search: a hint without text, the results with text. -->
            <Border Name="TaskHintCard" Classes="Card" Padding="24" IsVisible="{Binding ShowTaskHint}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Search the tasks of all projects" Classes="TitleMedium" />
                    <TextBlock Classes="BodyMedium" TextWrapping="Wrap"
                               Text="Type in the search field. It looks into the title, the description and the labels. Pick a due date filter to list tasks without typing." />
                </StackPanel>
            </Border>

            <Border Name="NoTaskMatchesCard" Classes="Card" Padding="24" IsVisible="{Binding HasNoTaskMatches}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nothing matches" Classes="TitleMedium" />
                    <TextBlock Classes="BodyMedium" TextWrapping="Wrap"
                               Text="No task matches the search and the filters. Switch on 'Show closed' to include closed tasks." />
                </StackPanel>
            </Border>

            <ItemsControl Name="TaskResultList" ItemsSource="{Binding TaskResults}"
                          IsVisible="{Binding ShowTaskResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                        <Border Classes="Card" Margin="0,0,0,4" Padding="0">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenTaskCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Open the task in its project">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="IconContainer"
                                            Background="{Binding BackgroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}">
                                        <PathIcon Data="{Binding IconKey, Converter={x:Static controls:ResourceGeometryConverter.Instance}}"
                                                  Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Classes="TitleMedium"
                                                   MaxLines="2" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding ProjectName}" Classes="LabelMedium" />
                                            <TextBlock Text="·" Classes="BodyMedium" />
                                            <TextBlock Text="{Binding TypeName}" Classes="BodyMedium" />
                                            <TextBlock Text="·" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                            <TextBlock Text="{Binding LabelsText}" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                            <TextBlock Text="·" Classes="BodyMedium" IsVisible="{Binding HasDueDate}" />
                                            <Border Classes="Chip Chip-Overdue" IsVisible="{Binding IsOverdue}">
                                                <TextBlock Text="overdue" />
                                            </Border>
                                            <TextBlock Text="{Binding DueDateText}" Classes="BodyMedium"
                                                       IsVisible="{Binding HasDueDate}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Age}" Classes="Muted" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StatusLabel}" Classes="Muted"
                                                   HorizontalAlignment="Right" IsVisible="{Binding IsClosed}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding TaskResultsNote}" Classes="Muted"
                       IsVisible="{Binding TaskResultsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Project rows -->
            <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding ShowProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectCardViewModel">
                        <Border Classes="Card" Margin="0,0,0,4" Padding="0">
                            <!-- The card opens the project. Without a command
                                 the card would be a dead element. -->
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Open the project">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <!-- Leading folder icon on primaryContainer -->
                                    <Border Grid.Column="0" Classes="IconContainer"
                                            Background="{StaticResource PrimaryContainerBrush}">
                                        <PathIcon Data="{StaticResource IconFolder}"
                                                  Foreground="{StaticResource OnPrimaryContainerBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Classes="TitleMedium" />
                                        <TextBlock Text="{Binding UpdatedText}" Classes="BodyMedium" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OpenOfTotal}" Classes="LabelMedium"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Files that could not be read. They are never written to. -->
            <StackPanel IsVisible="{Binding HasUnreadable}" Spacing="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource StatusOpenBrush}" />
                    <TextBlock Text="{Binding UnreadableSummary}" Classes="SectionHeader" />
                </StackPanel>

                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="These files are left untouched. Fix them in the data folder and reload to see them." />

                <ItemsControl ItemsSource="{Binding Unreadable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:UnreadableFile">
                            <Border Classes="Card" Margin="0,4,0,0" Padding="12"
                                    Background="{StaticResource SurfaceContainerHighBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Path}" Classes="LabelMedium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Reason}" Classes="Muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
