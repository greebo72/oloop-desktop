<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        x:Class="OloopApp.Views.LoginDialog"
        x:DataType="vm:LoginViewModel"
        Title="Sign in to the server"
        Width="480"
        SizeToContent="Height"
        MinWidth="420"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <!-- Opaque surface: a dialog must never show the window behind it. -->
    <Border Background="{StaticResource SurfaceContainerHighBrush}" Padding="24,20,24,20">
        <StackPanel Spacing="18">

            <StackPanel Spacing="6">
                <TextBlock Text="Sign in to the server" Classes="TitleLarge" />
                <TextBlock Classes="BodyMedium" TextWrapping="Wrap" Text="{Binding ServerUrl}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="User" Classes="LabelMedium" />
                <TextBlock Text="{Binding UserName}" Classes="BodyLarge" />

                <TextBlock Text="Password *" Classes="LabelMedium" Margin="0,6,0,0" />
                <TextBox Name="PasswordBox" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" />
                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="The password of your account. Not the passphrase of your keys." />

                <TextBlock Text="Name of this computer *" Classes="LabelMedium" Margin="0,6,0,0" />
                <TextBox Text="{Binding DeviceName, Mode=TwoWay}" MaxLength="100" />
                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="The server lists your devices by this name, so you can cut one off if it is lost." />
            </StackPanel>

            <Border Classes="Field" Padding="12,8"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource StatusOpenBrush}" />
                    <TextBlock Text="{Binding Error}" Classes="BodyMedium" TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Text" Click="OnCancelClick" Content="Cancel" />
                <Button Classes="Primary" Click="OnSignInClick" Content="Sign in"
                        IsEnabled="{Binding CanSignIn}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
