<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        xmlns:models="using:OloopApp.Core.Models"
        x:Class="OloopApp.Views.NewProjectDialog"
        x:DataType="vm:NewProjectViewModel"
        Title="New project"
        Width="480"
        SizeToContent="Height"
        MinWidth="420"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <!-- Opaque surface: a dialog must never show the window behind it. -->
    <Border Background="{StaticResource SurfaceContainerHighBrush}" Padding="24,20,24,20">
        <StackPanel Spacing="18">

            <!-- ============================================================
                 Header
                 ============================================================ -->
            <StackPanel Spacing="2">
                <TextBlock Text="New project" Classes="TitleLarge" />
                <TextBlock Classes="BodyMedium"
                           Text="A project gets its own folder in the data folder. Its tasks live there." />
            </StackPanel>

            <!-- ============================================================
                 Name
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Name *" Classes="LabelMedium" />
                <TextBox Text="{Binding Name, Mode=TwoWay}"
                         MaxLength="200"
                         PlaceholderText="Name of the project" />
                <TextBlock Classes="Muted"
                           Text="Required. The folder name is derived from it." />
            </StackPanel>

            <!-- ============================================================
                 Reference path
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Reference path" Classes="LabelMedium" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding ReferencePath, Mode=TwoWay}"
                             PlaceholderText="Optional — the folder of the repository" />
                    <Button Grid.Column="1" Classes="Outlined" Click="OnBrowseReferencePathClick"
                            VerticalAlignment="Stretch">
                        Browse…
                    </Button>
                </Grid>
                <TextBlock Classes="Muted"
                           Text="Optional. The path of the repository this project belongs to, so oloop can find it again on this computer." />
            </StackPanel>

            <!-- ============================================================
                 Error
                 ============================================================ -->
            <Border Classes="Field" Padding="12,8"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource StatusOpenBrush}" />
                    <TextBlock Text="{Binding Error}" Classes="BodyMedium" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============================================================
                 Actions. Exactly one filled primary element on the screen.
                 ============================================================ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Text" Click="OnCancelClick" Content="Cancel" />
                <Button Classes="Primary" Click="OnCreateClick" Content="Create"
                        IsEnabled="{Binding CanSave}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
