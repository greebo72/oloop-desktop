<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OloopApp.ViewModels"
        x:Class="OloopApp.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        MinWidth="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <!-- Opaque surface: a dialog must never show the window behind it. -->
    <Border Background="{StaticResource SurfaceContainerHighBrush}" Padding="24,20,24,20">
        <StackPanel Spacing="18">

            <!-- ============================================================
                 Header
                 ============================================================ -->
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Classes="TitleLarge" />
                <TextBlock Classes="BodyMedium"
                           Text="Where oloop keeps the projects and who is written into the tasks." />
            </StackPanel>

            <!-- ============================================================
                 Data folder
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Data folder" Classes="LabelMedium" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding DataRoot, Mode=OneWay}"
                             IsReadOnly="True"
                             ToolTip.Tip="{Binding DataRoot}"
                             PlaceholderText="No data folder chosen" />
                    <Button Grid.Column="1" Classes="Outlined" Click="OnBrowseDataRootClick"
                            VerticalAlignment="Stretch">
                        Browse…
                    </Button>
                </Grid>
                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="The folder with one subfolder per project. Everything oloop knows lives there." />
            </StackPanel>

            <!-- ============================================================
                 Actor
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Actor name *" Classes="LabelMedium" />
                <TextBox Name="ActorBox"
                         Text="{Binding Actor, Mode=TwoWay}"
                         PlaceholderText="Your name" />
                <TextBlock Classes="Muted"
                           Text="Required. It is written into createdBy and updatedBy of every task." />
                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasNoActor}"
                           Text="No name yet. oloop asks for it before the first write — until a name is entered, no task is written." />
            </StackPanel>

            <!-- ============================================================
                 List preferences
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Task list" Classes="LabelMedium" />

                <CheckBox Content="Show closed tasks"
                          IsChecked="{Binding ShowClosed, Mode=TwoWay}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="8"
                      RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Group by" Classes="BodyMedium"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding GroupingModes}"
                              SelectedItem="{Binding Grouping, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Stale since (days)" Classes="BodyMedium"
                               VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   Minimum="0" Maximum="3650" Increment="1"
                                   FormatString="0.##"
                                   PlaceholderText="off"
                                   Value="{Binding StaleDaysValue, Mode=TwoWay}" />
                </Grid>

                <TextBlock Classes="Muted" TextWrapping="Wrap"
                           Text="Stale since hides the tasks that were not touched for that many days. Leave it empty to switch the filter off." />
            </StackPanel>

            <!-- ============================================================
                 Shortcuts
                 ============================================================ -->
            <StackPanel Spacing="6">
                <TextBlock Text="Shortcuts" Classes="LabelMedium" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="4"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+F" Classes="BodyMedium" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus the search" Classes="Muted" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+N" Classes="BodyMedium" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="New task in the open project" Classes="Muted" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+E" Classes="BodyMedium" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Edit the selected task" Classes="Muted" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+," Classes="BodyMedium" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="These settings" Classes="Muted" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Escape" Classes="BodyMedium" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Clear the search, or back to the projects" Classes="Muted" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="F5" Classes="BodyMedium" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Reload the data folder" Classes="Muted" />
                </Grid>
            </StackPanel>

            <!-- ============================================================
                 Error
                 ============================================================ -->
            <Border Classes="Field" Padding="12,8"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource StatusOpenBrush}" />
                    <TextBlock Text="{Binding Error}" Classes="BodyMedium" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============================================================
                 Actions. Exactly one filled primary element on the screen.
                 ============================================================ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Text" Click="OnCancelClick" Content="Cancel" />
                <Button Classes="Primary" Click="OnSaveClick" Content="Save"
                        IsEnabled="{Binding CanSave}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
