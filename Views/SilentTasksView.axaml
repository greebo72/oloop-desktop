<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OloopApp.ViewModels"
             xmlns:views="using:OloopApp.Views"
             xmlns:controls="using:OloopApp.Controls"
             x:Class="OloopApp.Views.SilentTasksView"
             x:DataType="vm:SilentTasksViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================================
             Header: the name of the view, the counts, the lower bound
             ============================================================ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="16,8,16,12">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconSilent}" Width="18" Height="18"
                          Foreground="{StaticResource OnSurfaceVariantBrush}" />
                <TextBlock Text="Silent since" Classes="TitleLarge" />
                <TextBlock Text="{Binding Summary}" Classes="BodyMedium" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                <!-- The lower bound of the age. Zero means every open task
                     is listed, the quietest first. -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16"
                              Foreground="{StaticResource OnSurfaceVariantBrush}" />
                    <NumericUpDown Minimum="0" Maximum="3650" Increment="1"
                                   FormatString="0.##"
                                   PlaceholderText="any age"
                                   Value="{Binding MinimumAgeValue, Mode=TwoWay}"
                                   MinWidth="110" />
                </StackPanel>

                <CheckBox Content="Show closed"
                          IsChecked="{Binding ShowClosed, Mode=TwoWay}"
                          VerticalAlignment="Center" />

            </StackPanel>

        </Grid>

        <!-- ============================================================
             List left, detail right
             ============================================================ -->
        <Grid Grid.Row="1" ColumnDefinitions="420,*">

            <ScrollViewer Grid.Column="0">
                <StackPanel Margin="12,4,12,16" Spacing="8">

                    <!-- The buckets of the view. -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SilenceGroupViewModel">
                                <StackPanel Spacing="2">

                                    <TextBlock Text="{Binding Title}"
                                               Classes="SectionHeader"
                                               Margin="4,10,0,4" />

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SilentTaskRowViewModel">
                                                <Border Classes="Card" Padding="0" Margin="0,0,0,4">
                                                    <!-- The row is a button that opens the
                                                         detail, and next to it the edit
                                                         button — a button cannot be
                                                         nested in a button. -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Button Background="Transparent"
                                                                Padding="12"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding $parent[ItemsControl].((vm:SilenceGroupViewModel)DataContext).SelectCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                                            <!-- Type icon on the type container -->
                                                            <Border Classes="IconContainer"
                                                                    Background="{Binding BackgroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}">
                                                                <PathIcon Data="{Binding IconKey, Converter={x:Static controls:ResourceGeometryConverter.Instance}}"
                                                                          Foreground="{Binding ForegroundKey, Converter={x:Static controls:ResourceBrushConverter.Instance}}" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Classes="TitleMedium"
                                                                           Classes.Closed="{Binding IsClosed}"
                                                                           MaxLines="2"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                                            Classes.ClosedMeta="{Binding IsClosed}">
                                                                    <!-- The project, because the
                                                                         tasks come from everywhere. -->
                                                                    <TextBlock Text="{Binding ProjectName}" Classes="BodyMedium" />
                                                                    <TextBlock Text="·" Classes="BodyMedium" />
                                                                    <TextBlock Text="{Binding TypeName}" Classes="BodyMedium" />
                                                                    <TextBlock Text="·" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                                                    <TextBlock Text="{Binding LabelsText}" Classes="BodyMedium" IsVisible="{Binding HasLabels}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Age}"
                                                                       Classes="Muted"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>

                                                    <Button Grid.Column="1"
                                                            Classes="Icon"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:SilenceGroupViewModel)DataContext).EditCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Edit the task (Ctrl+E)">
                                                        <PathIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Name="EmptyStateCard" Classes="Card"
                            IsVisible="{Binding IsEmpty}" Padding="20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding EmptyTitle}" Classes="TitleMedium" />
                            <TextBlock Classes="BodyMedium" TextWrapping="Wrap"
                                       Text="{Binding EmptyText}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource OutlineVariantBrush}">
                <Panel>
                    <!-- The detail is only created when a task is selected. -->
                    <ContentControl Content="{Binding Selected}">
                        <ContentControl.DataTemplates>
                            <DataTemplate x:DataType="vm:TaskDetailViewModel">
                                <views:TaskDetailView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasSelection}">
                        <PathIcon Data="{StaticResource IconSilent}" Width="32" Height="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <TextBlock Text="Select a task" Classes="TitleMedium" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a task from the list to see its details."
                                   Classes="BodyMedium" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>

        </Grid>

        <!-- ============================================================
             The line under the list: what the view shows
             ============================================================ -->
        <TextBlock Grid.Row="2" Text="{Binding FilterText}" Classes="Muted"
                   Margin="16,0,16,12" />

    </Grid>
</UserControl>
