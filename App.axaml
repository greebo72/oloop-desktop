<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OloopApp.App"
             xmlns:local="using:OloopApp"
             Name="oloop"
             RequestedThemeVariant="Dark">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About oloop" Click="OnAboutClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://oloop/Themes/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://oloop/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
