    <Geometry x:Key="IconBuild">M22.7 19l-9.1-9.1c0.9-2.3 0.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C0.4 7.1 0.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c0.4 0.4 1 0.4 1.4 0l2.3-2.3c0.5-0.4 0.5-1.1 0.1-1.4z</Geometry>
    <Geometry x:Key="IconBugReport">M20 8h-2.81a6 6 0 0 0-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5s-0.96 0.06-1.41 0.17L8.41 3 7 4.41l1.62 1.63A6 6 0 0 0 6.81 8H4v2h2.09C6 10.33 6 10.66 6 11v1H4v2h2v1c0 0.34 0 0.67 0.09 1H4v2h2.81a7 7 0 0 0 10.38 0H20v-2h-2.09c0.09-0.33 0.09-0.66 0.09-1v-1h2v-2h-2v-1c0-0.34 0-0.67-0.09-1H20V8zM14 16h-4v-2h4v2zm0-4h-4v-2h4v2z</Geometry>
    <Geometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99 0.9-1.99 2L2 18c0 1.1 0.9 2 2 2h16c1.1 0 2-0.9 2-2V8c0-1.1-0.9-2-2-2h-8l-2-2z</Geometry>
    <Geometry x:Key="IconSearch">M15.5 14h-0.79l-0.28-0.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-0.59 4.23-1.57l0.27 0.28v0.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</Geometry>
