<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         oloop — Material 3 dark theme.
         Token values come from the M3 handoff of the oloop spec
         (seed #4C5C92, dark scheme).
         ============================================================ -->

    <!-- Surfaces -->
    <Color x:Key="SurfaceColor">#121318</Color>
    <Color x:Key="SurfaceContainerLowColor">#1B1B21</Color>
    <Color x:Key="SurfaceContainerColor">#1F1F25</Color>
    <Color x:Key="SurfaceContainerHighColor">#292A2F</Color>
    <Color x:Key="SurfaceContainerHighestColor">#34343A</Color>

    <!-- Primary -->
    <Color x:Key="PrimaryColor">#B5C4FF</Color>
    <Color x:Key="OnPrimaryColor">#1D2D61</Color>
    <Color x:Key="PrimaryContainerColor">#344479</Color>
    <Color x:Key="OnPrimaryContainerColor">#DCE1FF</Color>

    <!-- Secondary / tertiary -->
    <Color x:Key="SecondaryContainerColor">#414659</Color>
    <Color x:Key="OnSecondaryContainerColor">#DFE1F9</Color>
    <Color x:Key="TertiaryContainerColor">#5B3D57</Color>
    <Color x:Key="OnTertiaryContainerColor">#FFD7F5</Color>

    <!-- Text -->
    <Color x:Key="OnSurfaceColor">#E3E1E9</Color>
    <Color x:Key="OnSurfaceVariantColor">#C6C5D0</Color>

    <!-- Outlines -->
    <Color x:Key="OutlineColor">#90909A</Color>
    <Color x:Key="OutlineVariantColor">#46464F</Color>

    <!-- Status -->
    <Color x:Key="StatusOpenColor">#A2D398</Color>

    <!-- Type containers. Todo = primaryContainer, feature = tertiaryContainer;
         the rest get their own tonal containers. -->
    <Color x:Key="TypeTodoColor">#DCE1FF</Color>
    <Color x:Key="TypeTodoBgColor">#344479</Color>
    <Color x:Key="TypeQuestionColor">#A5D6E0</Color>
    <Color x:Key="TypeQuestionBgColor">#1E3038</Color>
    <Color x:Key="TypeDecisionColor">#FFD7A1</Color>
    <Color x:Key="TypeDecisionBgColor">#362D1E</Color>
    <Color x:Key="TypeFeatureColor">#FFD7F5</Color>
    <Color x:Key="TypeFeatureBgColor">#5B3D57</Color>
    <Color x:Key="TypeBugColor">#FFB4AB</Color>
    <Color x:Key="TypeBugBgColor">#3B2420</Color>
    <Color x:Key="TypeClosedColor">#C6C5D0</Color>
    <Color x:Key="TypeClosedBgColor">#292A2F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="StatusOpenBrush" Color="{StaticResource StatusOpenColor}" />
    <SolidColorBrush x:Key="TypeTodoBrush" Color="{StaticResource TypeTodoColor}" />
    <SolidColorBrush x:Key="TypeTodoBgBrush" Color="{StaticResource TypeTodoBgColor}" />
    <SolidColorBrush x:Key="TypeQuestionBrush" Color="{StaticResource TypeQuestionColor}" />
    <SolidColorBrush x:Key="TypeQuestionBgBrush" Color="{StaticResource TypeQuestionBgColor}" />
    <SolidColorBrush x:Key="TypeDecisionBrush" Color="{StaticResource TypeDecisionColor}" />
    <SolidColorBrush x:Key="TypeDecisionBgBrush" Color="{StaticResource TypeDecisionBgColor}" />
    <SolidColorBrush x:Key="TypeFeatureBrush" Color="{StaticResource TypeFeatureColor}" />
    <SolidColorBrush x:Key="TypeFeatureBgBrush" Color="{StaticResource TypeFeatureBgColor}" />
    <SolidColorBrush x:Key="TypeBugBrush" Color="{StaticResource TypeBugColor}" />
    <SolidColorBrush x:Key="TypeBugBgBrush" Color="{StaticResource TypeBugBgColor}" />
    <SolidColorBrush x:Key="TypeClosedBrush" Color="{StaticResource TypeClosedColor}" />
    <SolidColorBrush x:Key="TypeClosedBgBrush" Color="{StaticResource TypeClosedBgColor}" />
    <SolidColorBrush x:Key="CodeBlockBgBrush" Color="#0C0D14" />

    <!-- ============================================================
         Material Symbols geometry, filled variant (weight 400).
         Inline paths, so no icon font is needed.

         The paths have to be filled shapes: a PathIcon fills its
         geometry, and the outlined (stroke) variant of an icon has no
         area - a plus made of two lines stays invisible and leaves a
         gap in the layout instead.
         ============================================================ -->

    <Geometry x:Key="IconChecklist">M22 7h-9v2h9V7zm0 8h-9v2h9v-2zM5.54 11 2 7.46l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41L5.54 11zm0 8L2 15.46l1.41-1.41 2.12 2.12 4.24-4.24 1.41 1.41L5.54 19z</Geometry>
